{
  "kind": "collectionType",
  "collectionName": "subdomain_redirects",
  "info": {
    "singularName": "subdomain-redirect",
    "pluralName": "subdomain-redirects",
    "displayName": "Subdomain Redirect",
    "description": "Redirect a published hostname to an HTTPS URL or CMS media item"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "hostname": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "destination": {
      "type": "string",
      "regex": "^https://[^\\s]+$"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "redirectStatus": {
      "type": "string",
      "regex": "^(301|302|307|308)$",
      "default": "302",
      "required": true
    },
    "preservePath": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "preserveQuery": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
