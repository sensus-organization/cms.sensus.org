{
  "kind": "collectionType",
  "collectionName": "editions",
  "info": {
    "singularName": "edition",
    "pluralName": "editions",
    "displayName": "Edition"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "year": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string"
    },
    "biomarker": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "challenge": {
      "type": "text"
    },
    "videoUrl": {
      "type": "string"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "themeContent": {
      "type": "blocks"
    },
    "links": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "results": {
      "type": "component",
      "repeatable": true,
      "component": "archive.award-result"
    }
  }
}
